# Intent Money OS - 环境配置示例

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./intent_money.db

# JWT 密钥（生产环境请修改为强随机字符串）
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# AI 配置（OpenRouter）
AI_API_KEY=your-openrouter-api-key-here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-chat-v3-0324:free

# 平台 Cookie（可选，用于爬取数据）
# 如需启用，请填入对应平台的 Cookie 字符串
XHS_COOKIE=
DOUYIN_COOKIE=

# 短信服务配置（可选）
# 如需启用短信验证，请配置以下参数并设置 SMS_ENABLED=true
SMS_ENABLED=false
SMS_GATEWAY=
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 功能开关
SCRAPER_ENABLED=true
SCRAPER_TIMEOUT=30
SENTIMENT_ENABLED=true
AUTO_PUBLISH_ENABLED=false

# 其他配置
SOCIAL_AUTO_UPLOAD_PATH=
COOKIE_DIR=cookies
COOKIE_EXPIRE_DAYS=7

# 运行环境
# 可选值：development, production
ENV=development
