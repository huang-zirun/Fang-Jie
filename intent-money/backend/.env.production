# Intent Money OS - 生产环境配置
# 部署时将此文件复制为 .env 并修改相应值

# 数据库配置（Docker 容器内绝对路径）
DATABASE_URL=sqlite+aiosqlite:////app/data/intent_money.db

# JWT 密钥（⚠️ 生产环境必须修改为强随机字符串）
SECRET_KEY=CHANGE-ME-TO-A-STRONG-RANDOM-STRING-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# AI 配置（OpenRouter）
AI_API_KEY=sk-or-v1-YOUR-KEY-HERE
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-v4-flash

# 平台 Cookie（可选，用于爬取数据）
XHS_COOKIE=
DOUYIN_COOKIE=

# 短信服务配置（可选）
SMS_ENABLED=false
SMS_GATEWAY=
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 功能开关
SCRAPER_ENABLED=false
SCRAPER_TIMEOUT=30
SENTIMENT_ENABLED=true
AUTO_PUBLISH_ENABLED=false

# 自动发布配置（Linux 服务器路径）
SOCIAL_AUTO_UPLOAD_PATH=
COOKIE_DIR=cookies
COOKIE_EXPIRE_DAYS=7

# 运行环境
ENV=production

# 开发模式配置（生产环境必须为 false）
DEV_MODE=false
